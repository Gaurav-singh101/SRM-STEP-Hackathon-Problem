# ---------------------------------------------------------------------------
# Example environment file. PLACEHOLDERS ONLY - never commit real secrets.
# Copy to .env and adjust locally:  cp .env.example .env
# CLAUDE.md S3/S7: config via environment only; no constants in code.
# ---------------------------------------------------------------------------

# --- Service identity / logging -------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Kafka ----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=telemetry.raw
KAFKA_TOPIC_DLQ=telemetry.dlq
KAFKA_TOPIC_LATE=telemetry.late
KAFKA_TOPIC_IDLE_EVENTS=idle.events
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP=processor
# ADR-0004: 24 partitions (divisible by 2/3/4/6/8/12 for flexible consumer counts)
KAFKA_NUM_PARTITIONS=24
KAFKA_REPLICATION_FACTOR=1
KAFKA_BATCH_MAX_MESSAGES=5000
KAFKA_POLL_TIMEOUT_SECONDS=1.0

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=localhost
# Host-side port. Not 5432: a locally installed PostgreSQL service often already
# owns that port, and connections would silently reach it instead of the container.
POSTGRES_PORT=55432
# The port docker compose publishes; keep it equal to POSTGRES_PORT above.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=16
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# --- MongoDB --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fleet_telemetry
MONGO_RAW_COLLECTION=telemetry_raw
# Hot-tier TTL. CLAUDE.md S8 lifecycle: raw telemetry expires out of the hot tier.
MONGO_RAW_TTL_SECONDS=172800

# --- Redis (7.2.x pinned - see ADR-0002 / CLAUDE.md S4) -------------------
REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL_SECONDS=86400

# --- Auth (D4: generic OIDC/JWT; no vendor in code) -----------------------
OIDC_ISSUER=http://localhost:8081
OIDC_AUDIENCE=fleet-api
OIDC_JWKS_URL=http://localhost:8081/jwks.json
# Allow-list only. Never 'none'; never HS256 from a JWKS issuer.
OIDC_ALLOWED_ALGORITHMS=RS256,ES256

# --- Business parameters: IDLE (D1, ADR-0001) - values are PROPOSED -------
IDLE_MIN_SECONDS=180
IDLE_ENTRY_SPEED_KPH=2.0
IDLE_EXIT_SPEED_KPH=5.0
IDLE_EXCESSIVE_SECONDS=600
IDLE_GAP_TOLERANCE_SECONDS=30
IDLE_EXCLUDE_DEPOT=false
IDLE_EXCLUDE_PTO_ACTIVE=false

# --- Business parameters: FUEL / COST (D2, ADR-0002) ----------------------
FUEL_FORMULA_VERSION=idle-fuel-v1
DEFAULT_CURRENCY=INR

# --- Business parameters: UTILISATION (D3, ADR-0003) ---------------------
UTILISATION_FORMULA_VERSION=utilisation-v1
UTIL_WEIGHT_ACTIVE_DAY=0.40
UTIL_WEIGHT_MOVING_HOURS=0.35
UTIL_WEIGHT_DISTANCE=0.25
UTIL_LOW_THRESHOLD=40.0
UTIL_NORMAL_UPPER=85.0
UTIL_ABNORMAL_Z=3.0

# --- Stream processing ----------------------------------------------------
ALLOWED_LATENESS_SECONDS=300
DEDUP_WINDOW_SECONDS=600

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PAGE_SIZE_DEFAULT=50
API_PAGE_SIZE_MAX=200
API_RATE_LIMIT_PER_MINUTE=600
API_CORS_ORIGINS=http://localhost:5173

# --- Simulator ------------------------------------------------------------
SIM_VEHICLE_COUNT=2000
SIM_SEED=20260929
SIM_EVENTS_PER_VEHICLE_SECONDS=10
SIM_DUPLICATE_RATE=0.01
SIM_OUT_OF_ORDER_RATE=0.02
SIM_MALFORMED_RATE=0.005

# --- Web ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
